void recive_keyboard_input(TextInputField* field, Key key, Keymods mods) recive_keyboard_input(*field.buf, *field.cursor, key, mods);

void recive_keyboard_input(Textbuffer* buf, Cursor* cursor, Key key, Keymods mods) {

    bool shift = (mods & Keymods.shift) != 0;

    if mods & Keymods.alt {
        switch key {
            case .down: push_line_down(buf, cursor); cursor_unselect(cursor); break;
            case .up:   push_line_up(buf, cursor);   cursor_unselect(cursor); break;
        }
    } else if mods & Keymods.control {
        switch (key) {
            case .right: jump_cursor(buf, cursor,  1); if !shift cursor_unselect(cursor); break;
            case .left:  jump_cursor(buf, cursor, -1); if !shift cursor_unselect(cursor); break;
            case .down:  jump_cursor_vertical(buf, cursor,  1); if !shift cursor_unselect(cursor); break;
            case .up:    jump_cursor_vertical(buf, cursor, -1); if !shift cursor_unselect(cursor); break;

            case .X: {
                char* text = selection_to_string(buf, @cursor, temp_builder()).chars;
                glfwSetClipboardString(app.main_window, text);
                delete_selection(buf, cursor);
            } break;
            case .C: {
                char* text = selection_to_string(buf, @cursor, temp_builder()).chars;
                glfwSetClipboardString(app.main_window, text);
            } break;
            case .V: {
                char* text = glfwGetClipboardString(app.main_window);
                insert(buf, cursor, text);
            } break;

            case .backspace: {
                jump_cursor(buf, cursor, -1);
                delete_selection(buf, cursor);
            } break;

            case .delete: {
                jump_cursor(buf, cursor, 1);
                delete_selection(buf, cursor);
            } break;

        }
    } else {
        switch (key) {
            case .right: move_cursor(buf, cursor,  1); if !shift cursor_unselect(cursor); break;
            case .left:  move_cursor(buf, cursor, -1); if !shift cursor_unselect(cursor); break;
            case .down:  move_cursor_vertical(buf, cursor,  1); if !shift cursor_unselect(cursor); break;
            case .up:    move_cursor_vertical(buf, cursor, -1); if !shift cursor_unselect(cursor); break;

            case .enter:     insert(buf, cursor, '\n'); break;
            case .tab:       insert_tab(buf, cursor); break;

            case .backspace: delete_backward(buf, cursor); cursor_unselect(cursor); break;
            case .delete: {

                if shift {
                    uint32 row = cursor.coord.row;
                    if row < list_length(buf.lines) {
                        let sb = get_string_builder(buf, row);
                        glfwSetClipboardString(app.main_window, sb.content);
                        delete_row(buf, row, null);

                        if row != 0 and row >= list_length(buf.lines) {
                            cursor.coord.row--;
                        }
                    }

                } else {
                    delete_forward(buf, cursor);
                }
                cursor_unselect(cursor);
            } break;

            case .home: {
                let sb = get_string_builder(buf, cursor.coord.row);

                uint32 col = 0;
                while is_whitespace(sb.content[col]) col++;

                if cursor.coord.col == col    cursor.coord.col = 0;
                else                          cursor.coord.col = col;

                if !shift cursor_unselect(cursor);
            } break;

            case .end: {
                cursor.coord.col = buf.lines[cursor.coord.row].sb.length;
                if !shift cursor_unselect(cursor);
            } break;
        }
    }
}
