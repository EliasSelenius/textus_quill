// TODO: this immediate mode text input idea should be in grax
uint32 on_text_input_call_count = 0;
char* text_input_this_frame = malloc(128);


void on_event(AppEvent event) switch (event.kind) {
    case .file_drop: {
        glfwFocusWindow(app.main_window);

        for i : 0 .. event.files.length {
            let ed = texteditor_open_file(event.files[i]);
        }
    } break;

    case .key_repeat:
    case .key_press: {
        // print("[INFO]: \"", glfwGetKeyName(Key.unknown, event.scancode), "\" scancode: ", event.scancode, " key: ", event.key, " mods: ", event.mods, "\n");

        if (event.mods & .num_lock) == 0 {
            event.key = keypad_convert_to_function(event.key);
        }

        event.mods &= ~(.num_lock | .caps_lock);

        if file_selector.open {
            switch (event.key) {
                case .up:   file_selector.entry_index--; break;
                case .down: file_selector.entry_index++; break;
                case .enter: {
                    let entry = file_selector.entries[file_selector.entry_index];
                    let file = file_selector.files[entry.file_index];
                    switch (file.file_kind) {
                        case .file: {
                            texteditor_open_file(file.full_path.chars);
                            file_selector.open = false;
                        } break;
                        case .folder: {
                            let sb = get_string_builder(*file_selector.text_field.buf, 0);
                            sb_clear(sb);
                            file_selector.text_field.cursor = {};
                            insert(*file_selector.text_field.buf, *file_selector.text_field.cursor, file.full_path);
                            insert(*file_selector.text_field.buf, *file_selector.text_field.cursor, "\\");
                            update_files(*file_selector);
                        } break;
                        case .symlink: {

                        } break;
                    }

                } break;
                default: {
                    recive_keyboard_input(*file_selector.text_field, event.key, event.mods);
                    update_files(*file_selector);
                } break;
            }


        } else if active_editor {
            text_editor_recive_keyboard_input(active_editor, event.key, event.mods);
        }

        switch (event.mods) {
            case .none: switch (event.key) {
                case .escape: file_selector.open = false; break;
            } break;

            case .control: switch (event.key) {
                case .page_up: {
                    if active_editor.prev {
                        active_editor = active_editor.prev;
                        active_editor.cam.pos.x = 0;
                    }
                } break;
                case .page_down: {
                    if active_editor.next {
                        active_editor = active_editor.next;
                        active_editor.cam.pos.x = 0;
                    }
                } break;

                case .P: file_selector.open = true; update_files(*file_selector); break;

                case .T: {
                    static uint32 theme_index = 0;
                    set_theme(themes[theme_index++ % themes.length]);
                } break;

                case .N: texteditor_new(); break;
                case .W: if active_editor texteditor_free(active_editor); break;
            } break;

            case .alt: switch (event.key) {
            } break;
        }
    } break;

    case .text_input: {
        char c = '?';
        if event.unicode_codepoint <= 127 {
            c = event.unicode_codepoint as char;
        } else {
            print("[ERROR]: Unicode character ", to_string(event.unicode_codepoint), " not supported.\n");
        }


        if file_selector.open {
            insert(*file_selector.text_field.buf, *file_selector.text_field.cursor, c);
            update_files(*file_selector);
        } else if active_editor {
            write(active_editor, utf8_encode(event.unicode_codepoint, temp_builder()));
            // write(active_editor, c);
        }

        text_input_this_frame[on_text_input_call_count++] = c;
    } break;

    default: break;
}

Transform2D camera_to_dispatch = {scale=1};
RenderLayer ui_layer;
RenderLayer static_ui;

enum EditorKind { text; image; }

struct Editor {
    EditorKind kind;
    Image_Editor* imged;
    Texteditor* txted;
}

Editor[..] editors = list_create(sizeof Editor);
int32 current_editor_index = 0;

Editor* current_editor() return *editors[current_editor_index];


void draw_window_frame() {

    bool decorated = glfwGetWindowAttrib(app.main_window, GLFW_DECORATED);
    bool maximized = glfwGetWindowAttrib(app.main_window, GLFW_MAXIMIZED);

    // glfwGetWindowPos(GLFWwindow* window, int32* xpos, int32* ypos);
    // glfwSetWindowPos(GLFWwindow* window, int32 xpos, int32 ypos);

    if decorated return;

    float win_width = 2.0 * app.width_over_height;
    float bar_height = 0.05;
    UI_Rect rect_bar = {{0, 1 - bar_height/2.0}, {win_width, bar_height}};

    vec2 iconsize = {bar_height, bar_height};

    UI_Rect rect_close    = place({{}, iconsize} as UI_Rect, 1,1,  app.top_right);
    UI_Rect rect_minimize = move(rect_close, -1, 0);
    UI_Rect rect_iconify  = move(rect_close, -2, 0);

    bool window_button(UI_Rect rect, Color color) {
        bool pressed = false;
        vec4 c = make_vec(color);

        if hover(rect) {
            if mouse_pressed(MouseButton.Left)   pressed = true;
            c = c*0.5;
        }

        draw_rect(rect, rgba(c));
        return pressed;
    }

    draw_rect(rect_bar, DarkGray);

    Color color = White;

    if window_button(rect_iconify, color) {
        glfwIconifyWindow(app.main_window);
    }

    if window_button(rect_minimize, color) {
        if maximized glfwRestoreWindow(app.main_window);
        else         glfwMaximizeWindow(app.main_window);
    }

    if window_button(rect_close, color) {
        glfwSetWindowShouldClose(app.main_window, true);
    }

}


int32 main() {

    grax_init();
    app.on_event = on_event;

    // glfwSetWindowAttrib(app.main_window, GLFW_DECORATED, GLFW_FALSE);

    // DwmExtendFrameIntoClientArea();

    init_draw2d();

    init_themes();
    init_languages();

    texteditor_new();
    texteditor_open_file("src/textbuffer.pog");

    load_all_projects_in_folder("D:/Documents/repos");


    {
        let controls = texteditor_new();
        write(controls, make_string("\n\n"));
        write(controls, make_string("// Drag and drop files into this window to view and edit them\n\n\n"));

        write(controls, make_string("// Ctrl+N               --  New text buffer.\n"));
        write(controls, make_string("// Ctrl+S               --  Save text buffer.\n"));
        write(controls, make_string("// Ctrl+W               --  Close text buffer.\n"));
        write(controls, make_string("// Ctrl+page_up/down    --  Cycle text buffers.\n"));
        write(controls, make_string("// Ctrl+P               --  Blue screen your computer.\n"));
        write(controls, make_string("// Ctrl+arrow_keys      --  Jump over text.\n"));
        write(controls, make_string("// Alt+up/down          --  Move line up/down.\n"));
        write(controls, make_string("// Ctrl+\"-\"             --  Zoom out.\n"));
        write(controls, make_string("// Ctrl+\"=\"             --  Zoom in. I guess this only works on english keyboard layout, opsie.\n"));
        write(controls, make_string("// F11                  --  Toggle fullscreen mode.\n"));
        write(controls, make_string("// Ctrl+T               --  Change color theme.\n"));

        write(controls, make_string("\n\n"));
        write(controls, make_string("// Cycle to the next text buffer to see the source code for the editor viewed in itself.\n\n"));
    }


    {
        file_selector.text_field.buf = create_textbuffer();
        file_selector.text_field.cursor = {};
        let cwd = get_cwd();
        insert(*file_selector.text_field.buf, *file_selector.text_field.cursor, cwd);
        free(cwd.chars);
        update_files(*file_selector);

        file_selector.color_background = opacity(Blue, 0.8);

        static_ui = create_layer();
        ui_layer = create_layer();
        immediate_layer = *static_ui;
    }

    let img_ed = open_image("../sector/assets/spritesheet.bmp");

    while grax_loop() {
        UI_Rect rect_window = rect_pp(app.bottom_left, app.top_right);

        static ivec2 window_pos_prev = {};
        static ivec2 window_pos = {};

        window_pos_prev = window_pos;
        glfwGetWindowPos(app.main_window, *window_pos.x, *window_pos.y);

        ivec2 diff = window_pos - window_pos_prev;

        calc_theme();
        set_clear_color(theme.background);

        draw_window_frame();

        let ed = active_editor;
        if ed {
            Cursor old_cursor = ed.cursor;
            float gh = ed.glyph_height;

            UI_Rect rect_ed = rect_window;

            let mouse_pos = local2world(ed.cam, Input.mouse_pos);

            uint32 mouse_row = clamp(round(-mouse_pos.y / gh), 0, list_length(ed.buf.lines) - 1) as uint32;
            uint32 mouse_col = clamp(round(mouse_pos.x / (gh*0.5)), 0, get_string_builder(*ed.buf, mouse_row).length) as uint32;

            // draw_rect(*ui_layer, mouse_pos, make_vec2(gh), White);
            // draw_text(*ui_layer, mouse_pos, gh, to_string(mouse_row), Black);

            if mouse_down(MouseButton.Left) {
                ed.cursor.coord = {mouse_row, mouse_col};
                if !key_down(Key.left_shift) {
                    ed.cursor.start = ed.cursor.coord;
                }
            }

            void zoom(Texteditor* ed, float32 zoom) {
                const speed = 0.05;
                ed.target_cam.scale *= 1.0 + speed*zoom;
            }

            if key_down(Key.left_control) {
                zoom(ed, input_axis('-', '='));
            }

            if mouse_scroll != 0.0 {
                if key_down(Key.left_control) {
                    zoom(ed, -mouse_scroll);
                } else {
                    // ed.target_view_pos.y += mouse_scroll * 0.1;
                    ed.target_cam.pos.y += mouse_scroll * 0.1 * ed.cam.scale;
                    ed.follow_cursor = false;
                }
            }


            {
                let cursor_pos = calc_cursor_pos(ed);

                float win_height = ed.cam.scale*2.0;
                float win_width  = win_height * app.width_over_height;

                float x = win_width/4.0;

                if cursor_pos.x > win_width/2.0 {
                    x = cursor_pos.x - win_height/2.0;
                }

                float gh_linenums = gh * 0.7;
                float linenum_space = gh_linenums/2.0 * 5;
                float margin = gh*2 + linenum_space;

                ed.target_cam.pos.x = max(win_width/2.0 - margin, x);


                if ed.follow_cursor {
                    float diff = ed.cam.pos.y - cursor_pos.y;
                    float thres = gh*10.0;
                    if abs(diff) > thres {
                        ed.target_cam.pos.y = cursor_pos.y;
                    }
                }

            }

            static float decay = 30;
            float dt = deltatime();
            exp_decay(*ed.cam.pos.y, ed.target_cam.pos.y, decay, dt);
            exp_decay(*ed.cam.pos.x, ed.target_cam.pos.x, decay, dt);
            exp_decay(*ed.cam.scale, ed.target_cam.scale, decay, dt);
            camera_to_dispatch = ed.cam;

            scrollbar(rect_ed, ed);
            draw_texteditor(*ui_layer, ed);
            draw_tabs(*static_ui, ed);

            ed.prev_cursor = old_cursor;

        } else draw_project_selection_menu();

        if file_selector.open {
            render_file_selection_menu(*file_selector);
        }

        // draw_img_editor(*img_ed, *ui_layer);

        dispatch_sprites(camera_to_dispatch);
        dispatch_layer(*ui_layer, camera_to_dispatch);
        dispatch_layer(*static_ui, {scale=1} as Transform2D);

        // const border_thickness = 0.005;
        // draw_rect(make_vec(-1, 0), make_vec(border_thickness, 2), Red);
        // draw_rect(make_vec(1, 0), make_vec(border_thickness, 2), Red);

        text_input_this_frame[on_text_input_call_count] = 0;
        // if on_text_input_call_count != 0 print("\"", text_input_this_frame, "\"\n");
        on_text_input_call_count = 0;
    }

    return 0;
}

void draw_tabs(RenderLayer* layer, Texteditor* ed) {
    const tab_text_height = 0.05;
    vec2 pos = app.top_left + make_vec(tab_text_height, -tab_text_height) * 0.5;
    let current_ed = ed;
    loop: {
        string full_path = current_ed.file_name.chars ? current_ed.file_name : make_string("untitled");

        string path, file;
        decompose_path(full_path, *path, *file);

        pos = draw_text(layer, pos, tab_text_height, file, White);
        pos.x += tab_text_height * 2;

        if current_ed == active_editor {
            vec2 p = app.bottom_left + make_vec2(tab_text_height * 0.5);
            draw_text(layer, p, tab_text_height, full_path, White);
        }

        current_ed = current_ed.next;
        if current_ed != ed goto loop;
    }
}

void scrollbar(UI_Rect rect_ed, Texteditor* ed) {
    float px = 2.0 / app.window_height;
    float gh = ed.glyph_height;

    uint32 line_count = list_length(ed.buf.lines);
    float buffer_height = line_count * gh;

    float w = 20*px;
    float vh = rect_ed.size.y;

    float s = vh * ed.cam.scale / buffer_height;
    float p = ed.cam.pos.y / buffer_height;

    float sh = vh * s;

    UI_Rect rect_slide = child(rect_ed, 1,0, w, vh);
    UI_Rect rect_slider = translate(child(rect_slide, 0,1,  w,sh),  0, sh/2.0 + vh * p);

    vec4 color_slide  = {0.5,0.5,0.5, 0.2};
    vec4 color_slider = {0.6,0.6,0.6, 0.2};

    if hover(rect_slide) {
        float my = Input.mouse_pos.y;
        float p = (my - top(rect_slide)) / vh;

        if mouse_down(MouseButton.Left) {
            ed.target_cam.pos.y = buffer_height*p;
        }

        draw_rect(translate(child(rect_slide, 0,1,  w,2.0*px),  0, px + vh * p),  White);

        if hover(rect_slider) {
            color_slider.w = 1.0;
        }
    }


    draw_rect(rect_slide,  rgba(color_slide));
    draw_rect(pad(rect_slider, 4.0*px), rgba(color_slider));

}

